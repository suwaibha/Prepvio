NODE_ENV=development
PORT=5000
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174
# In production, use your deployed frontend origins, comma-separated:
# FRONTEND_ORIGINS=https://app.yourdomain.com,https://admin.yourdomain.com

# MongoDB
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/dbname

# JWT
JWT_SECRET=your_jwt_secret_here

# Google OAuth (REQUIRED — app will crash without these)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Client URL (for redirects)
CLIENT_URL=http://localhost:5173

# SMTP / Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="Your App <your_email@gmail.com>"

# AI Keys
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key
GROQ_SUMMARY_MODEL=llama-3.3-70b-versatile
GROQ_CHUNK_MODEL=llama-3.1-8b-instant

# Cloudflare R2
CLOUDFLARE_ACCOUNT_ID=your_account_id
R2_BUCKET_NAME=interview-reports
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_PUBLIC_DOMAIN=your_r2_public_domain

# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Admin
ADMIN_EMAIL=admin@yourapp.com
ADMIN_PASSWORD=your_admin_password
ADMIN_DASHBOARD_URL=http://localhost:5174

# Deepgram
DEEPGRAM_API_KEY=your_deepgram_api_key
